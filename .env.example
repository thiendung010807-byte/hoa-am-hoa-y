# Public production URL. Example: https://hoa-am-hoa-y.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile. Production registration fails closed if secret is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Apps Script Web App (/exec) and its secret.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Random 32+ byte secret used to HMAC the visitor IP before short-lived rate limiting.
# The raw IP and hash are NOT written to Google Sheets.
IP_HASH_SALT=
